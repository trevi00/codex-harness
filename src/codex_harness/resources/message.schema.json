{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-harness:six-w:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "task.assign",
        "task.result",
        "incident.report",
        "hook.required",
        "review.result"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "who": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sender": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sender",
        "recipient",
        "owner"
      ]
    },
    "what": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "action",
        "details"
      ]
    },
    "why": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "objective",
        "evidence_refs"
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "created_at",
        "deadline",
        "after"
      ]
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "repository",
        "revision",
        "environment",
        "allowed_paths"
      ]
    },
    "how": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "context_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_schema": {
          "const": "six-w.v1"
        }
      },
      "required": [
        "constraints",
        "acceptance_criteria",
        "context_ref",
        "result_schema"
      ]
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "type",
    "correlation_id",
    "causation_id",
    "who",
    "what",
    "why",
    "when",
    "where",
    "how"
  ]
}
